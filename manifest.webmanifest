{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Tempo — Focus Timer",
  "short_name": "Tempo",
  "description": "A calm, editorial focus timer with Pomodoro, world clock, stopwatch, and a custom countdown — all offline-capable.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14110f",
  "theme_color": "#14110f",
  "categories": ["productivity", "utilities", "lifestyle"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
